{
  "name": "ydt",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf target types && tsc",
    "start": "node target",
    "test": "c8 mocha test/**/*.{ts,tsx}",
    "watch": "tsc --watch --preserveWatchOutput"
  },
  "c8": {
    "all": true,
    "extension": [
      ".ts",
      ".tsx"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "include": [
      "src/**/*"
    ],
    "reporter": [
      "html",
      "text",
      "lcov"
    ]
  },
  "keywords": [],
  "author": "Grzegorz Abramczyk <abramczykg@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.1",
    "@types/sinon": "^17.0.4",
    "@types/sinon-chai": "^4.0.0",
    "c8": "^10.1.3",
    "chai": "^6.0.1",
    "chai-as-promised": "^8.0.2",
    "mocha": "^11.7.2",
    "prettier": "^3.6.2",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "yaml": "^2.8.1"
  }
}