{
  "name": "@agrzes/ydt-cli",
  "version": "1.0.0-alpha.2",
  "description": "Two phase templating using handlebars to configure generation of files also using handlebars. CLI module.",
  "main": "index.js",
  "bin": {
    "ydt": "./bin/ydt.mjs"
  },
  "scripts": {
    "prepublishOnly": "pnpm install --frozen-lockfile && pnpm build && pnpm test",
    "build": "rm -rf target types && tsc",
    "start": "node target",
    "test": "vitest run",
    "watch": "tsc --watch --preserveWatchOutput"
  },
  "vitest": {
    "test": {
      "include": [
        "test/**/*.ts"
      ],
      "exclude": [
        "node_modules",
        "dist"
      ]
    }
  },
  "keywords": [
    "cli",
    "templating",
    "handlebars",
    "yaml"
  ],
  "author": "Grzegorz Abramczyk <abramczykg@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/node": "^24.3.1",
    "@types/sinon": "^17.0.4",
    "@types/sinon-chai": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "chai": "^6.0.1",
    "chai-as-promised": "^8.0.2",
    "prettier": "^3.6.2",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "@agrzes/ydt": "workspace:^",
    "yaml": "^2.8.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AGrzes/ydt.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/AGrzes/ydt/issues"
  },
  "homepage": "https://github.com/AGrzes/ydt",
  "files": [
    "bin",
    "target"
  ],
  "publishConfig": {
    "access": "public"
  }
}